config.yaml
node_modules/
dist/
src-tauri/target/
# Regenerated by tauri-build on every build from tauri.conf.json and the
# installed plugins. Committing it means a stale copy conflicting on each pull.
src-tauri/gen/schemas/
models/
*.wav
*.opus
.DS_Store
.env

# The Kokoro weights are placed by hand (see SETUP.md) and are far too
# large to commit.
# Named explicitly rather than by wildcard: a blanket *.onnx rule also caught
# the 1.3MB Silero VAD model, which MUST stay committed because vad.rs embeds
# it with include_bytes! and the build fails without it.
src-tauri/assets/kokoro*.onnx
src-tauri/assets/*.bin
